#include <Servo.h>
#include <SPI.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SH110X.h>

// --- WI-FI SETUP ---
const char* ssid = "Robot_Control"; 
const char* password = "";          
ESP8266WebServer server(80); 

// --- SERVO SETUP ---
Servo rightLeg;
Servo leftLeg;
Servo rightFoot;
Servo leftFoot;

const int RIGHT_LEG_PIN = 14;  // D5
const int LEFT_LEG_PIN = 12;   // D6
const int RIGHT_FOOT_PIN = 13; // D7
const int LEFT_FOOT_PIN = 15;  // D8

const int CENTER = 90;
const int TILT_RIGHT = 120;
const int TILT_LEFT = 60;
const int STEP_DELAY = 12;  

// State tracking 
char currentCommand = 'S'; 
bool isStanding = false;
unsigned long lastBlinkTime = 0; 

// --- OLED SETUP ---
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
#define SCREEN_ADDRESS 0x3C 
Adafruit_SH1106G display = Adafruit_SH1106G(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

const int ref_eye_height = 40;
const int ref_eye_width = 40;
const int ref_space_between_eye = 10;
const int ref_corner_radius = 10;

int left_eye_height = ref_eye_height, left_eye_width = ref_eye_width;
int right_eye_height = ref_eye_height, right_eye_width = ref_eye_width;
int left_eye_x = 32, left_eye_y = 32;
int right_eye_x = 32 + ref_eye_width + ref_space_between_eye, right_eye_y = 32;

// --- OLED ANIMATION FUNCTIONS --- //

void draw_eyes(bool update = true) {
  display.clearDisplay();        
  display.fillRoundRect(left_eye_x - left_eye_width / 2, left_eye_y - left_eye_height / 2, 
                        left_eye_width, left_eye_height, ref_corner_radius, SH110X_WHITE);
  display.fillRoundRect(right_eye_x - right_eye_width / 2, right_eye_y - right_eye_height / 2, 
                        right_eye_width, right_eye_height, ref_corner_radius, SH110X_WHITE);    
  if(update) display.display();
}

void center_eyes(bool update = true) {
  left_eye_height = right_eye_height = ref_eye_height;
  left_eye_width = right_eye_width = ref_eye_width;
  left_eye_x = SCREEN_WIDTH / 2 - ref_eye_width / 2 - ref_space_between_eye / 2;
  right_eye_x = SCREEN_WIDTH / 2 + ref_eye_width / 2 + ref_space_between_eye / 2;
  left_eye_y = right_eye_y = SCREEN_HEIGHT / 2;
  draw_eyes(update);
}

void blink(int speed = 12) {
  draw_eyes();
  for(int i = 0; i < 3; i++) {
    left_eye_height -= speed; right_eye_height -= speed;    
    draw_eyes(); delay(1);
  }
  for(int i = 0; i < 3; i++) {
    left_eye_height += speed; right_eye_height += speed;
    draw_eyes(); delay(1);
  }
  center_eyes(true);
}

void sleep_eyes() {
  left_eye_height = right_eye_height = 2;
  draw_eyes(true);  
}

void wakeup() {
  sleep_eyes();
  delay(1000);
  for(int h = 0; h <= ref_eye_height; h += 2) {
    left_eye_height = right_eye_height = h;
    draw_eyes(true);
  }
}

void happy_eye() {
  center_eyes(false);
  int offset = ref_eye_height / 2;
  
  for(int i = 0; i < 10; i++) {
    // Slices from the top down (upside-down eyes)
    display.fillTriangle(
        left_eye_x - left_eye_width/2 - 1, left_eye_y - offset, 
        left_eye_x + left_eye_width/2 + 1, left_eye_y - 5 - offset, 
        left_eye_x - left_eye_width/2 - 1, left_eye_y - left_eye_height - offset, 
        SH110X_BLACK
    );
    
    display.fillTriangle(
        right_eye_x + right_eye_width/2 + 1, right_eye_y - offset, 
        right_eye_x - left_eye_width/2 - 1, right_eye_y - 5 - offset, 
        right_eye_x + right_eye_width/2 + 1, right_eye_y - left_eye_height - offset, 
        SH110X_BLACK
    );  
    
    offset -= 2; 
    display.display(); 
    delay(1);
  }
  
  // The feet tippy-tap dance
  for (int i = 0; i < 3; i++) {
    smoothMove2(rightFoot, TILT_RIGHT, leftFoot, TILT_RIGHT); 
    smoothMove2(rightFoot, TILT_LEFT, leftFoot, TILT_LEFT);   
  }
  
  stand(); 
  center_eyes(true);
}

void demon_mode() {
  center_eyes(false);
  
  display.fillTriangle(
    left_eye_x - left_eye_width / 2, left_eye_y + left_eye_height / 2, 
    left_eye_x + left_eye_width / 2, left_eye_y,                       
    left_eye_x + left_eye_width / 2, left_eye_y + left_eye_height / 2, 
    SH110X_BLACK
  );
  
  display.fillTriangle(
    right_eye_x + right_eye_width / 2, right_eye_y + right_eye_height / 2, 
    right_eye_x - right_eye_width / 2, right_eye_y,                        
    right_eye_x - right_eye_width / 2, right_eye_y + right_eye_height / 2, 
    SH110X_BLACK
  );
  
  display.display();
  delay(2000); 
  center_eyes(true);
}

void saccade(int dir_x, int dir_y) {
  int move_x = 8 * dir_x, move_y = 6 * dir_y, blink_amp = 8;
  for(int phase = 0; phase < 2; phase++) {
    left_eye_x += move_x; right_eye_x += move_x;    
    left_eye_y += move_y; right_eye_y += move_y;    
    int modifier = (phase == 0) ? -blink_amp : blink_amp;
    right_eye_height += modifier; left_eye_height += modifier;
    draw_eyes(); delay(1);
  }
}

void random_saccade() {
  center_eyes(true);
  for(int i = 0; i < 15; i++) { 
    int dir_x = random(-1, 2), dir_y = random(-1, 2);
    saccade(dir_x, dir_y); delay(50);
    saccade(-dir_x, -dir_y); delay(50);     
  }
  center_eyes(true);
}


