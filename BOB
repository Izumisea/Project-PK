// --- SETUP ROUTINE ---
void setup() {
  Serial.begin(115200);
  
  if(!display.begin(SCREEN_ADDRESS, true)) {
    Serial.println(F("SH1106 allocation failed"));
  }
  display.clearDisplay();
  display.display();
  
  rightLeg.attach(RIGHT_LEG_PIN);
  leftLeg.attach(LEFT_LEG_PIN);
  rightFoot.attach(RIGHT_FOOT_PIN);
  leftFoot.attach(LEFT_FOOT_PIN);
  stand();

  wakeup();

  WiFi.softAP(ssid, password);
  server.on("/", []() { server.send(200, "text/html", MAIN_page); });
  
  server.on("/action", []() {
    if (server.hasArg("go")) {
      currentCommand = server.arg("go").charAt(0);
      isStanding = false; 
    }
    server.send(200, "text/plain", "OK");
  });
  server.begin();
}

// --- MAIN LOOP ---
void loop() {
  server.handleClient();

  if (currentCommand == 'H') { happy_eye(); currentCommand = 'S'; }
  else if (currentCommand == 'D') { demon_mode(); currentCommand = 'S'; }
  else if (currentCommand == 'X') { random_saccade(); currentCommand = 'S'; }
  
  else if (currentCommand == 'F') walkForward();
  else if (currentCommand == 'B') walkBackward();
  else if (currentCommand == 'R') turnRight();
  else if (currentCommand == 'L') turnLeft();
  else if (currentCommand == 'S') {
    if (!isStanding) {
      stand();
      isStanding = true;
    }
  }

  if (millis() - lastBlinkTime >= 5000) {
    if (currentCommand == 'S') { 
      blink(); 
    }
    lastBlinkTime = millis();
  }
}


// --- SERVO MOVEMENT FUNCTIONS --- //

void stand() { smoothMove4(rightLeg, CENTER, leftLeg, CENTER, rightFoot, CENTER, leftFoot, CENTER); }

void walkForward() {
  smoothMove2(rightFoot, TILT_RIGHT, leftFoot, TILT_RIGHT); 
  smoothMove2(leftLeg, 60, rightLeg, 60); 
  smoothMove2(rightFoot, TILT_LEFT, leftFoot, TILT_LEFT); 
  smoothMove2(leftLeg, 120, rightLeg, 120); 
}

void walkBackward() {
  smoothMove2(rightFoot, TILT_RIGHT, leftFoot, TILT_RIGHT);
  smoothMove2(leftLeg, 120, rightLeg, 120); 
  smoothMove2(rightFoot, TILT_LEFT, leftFoot, TILT_LEFT);
  smoothMove2(leftLeg, 60, rightLeg, 60); 
}

void turnRight() {
  smoothMove2(rightFoot, TILT_RIGHT, leftFoot, TILT_RIGHT);
  smoothMove2(leftLeg, 60, rightLeg, 120); 
  smoothMove2(rightFoot, TILT_LEFT, leftFoot, TILT_LEFT);
  smoothMove2(leftLeg, CENTER, rightLeg, CENTER); 
}

void turnLeft() {
  smoothMove2(rightFoot, TILT_LEFT, leftFoot, TILT_LEFT);
  smoothMove2(rightLeg, 120, leftLeg, 60); 
  smoothMove2(rightFoot, TILT_RIGHT, leftFoot, TILT_RIGHT);
  smoothMove2(rightLeg, CENTER, leftLeg, CENTER); 
}

// --- SERVO SMOOTHING ENGINE --- //
void smoothMove2(Servo &s1, int target1, Servo &s2, int target2) {
  int start1 = s1.read(); int start2 = s2.read();
  int maxSteps = max(abs(target1 - start1), abs(target2 - start2));
  for (int step = 0; step <= maxSteps; step++) {
    if (maxSteps == 0) break; 
    s1.write(map(step, 0, maxSteps, start1, target1));
    s2.write(map(step, 0, maxSteps, start2, target2));
    
    server.handleClient();
    if (currentCommand == 'S') return; 
    delay(STEP_DELAY); 
  }
}

void smoothMove4(Servo &s1, int target1, Servo &s2, int target2, Servo &s3, int target3, Servo &s4, int target4) {
  int start1 = s1.read(); int start2 = s2.read(); int start3 = s3.read(); int start4 = s4.read();
  int maxSteps12 = max(abs(target1 - start1), abs(target2 - start2));
  int maxSteps34 = max(abs(target3 - start3), abs(target4 - start4));
  int maxSteps = max(maxSteps12, maxSteps34);
  for (int step = 0; step <= maxSteps; step++) {
    if (maxSteps == 0) break; 
    s1.write(map(step, 0, maxSteps, start1, target1));
    s2.write(map(step, 0, maxSteps, start2, target2));
    s3.write(map(step, 0, maxSteps, start3, target3));
    s4.write(map(step, 0, maxSteps, start4, target4));
    delay(STEP_DELAY); 
  }
}
