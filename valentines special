const unsigned char* const animationFramesS[] PROGMEM = {
  epd_bitmap_101,
  epd_bitmap_202
};
const int frameCountS = 2; 

// --- CONTROLS ---
const int buttonPin = 2; 
const int relayPin = 3;   // <--- RELAY PIN ADDED HERE
int mode = 0;             
int lastButtonState = HIGH; 
unsigned long lastDebounceTime = 0;  
unsigned long debounceDelay = 50;    

// --- ANIMATION TIMING ---
int currentFrame = 0;   
int currentFrameS = 0;         
unsigned long lastFrameTime = 0; 
const int frameDelay = 50;      

// --- RELAY TIMING ---
int relayState = LOW;             // Tracks if relay is currently ON or OFF
unsigned long lastRelayTime = 0;  // Timer for the relay
const int relayInterval = 1500;   // 1.5 Seconds (1500 ms)

void setup() {
  Serial.begin(9600);
  pinMode(buttonPin, INPUT_PULLUP);
  pinMode(relayPin, OUTPUT);      // <--- SETUP RELAY PIN

  display.begin(i2c_Address, true);
  display.clearDisplay();
  display.display();
}

void loop() {
  // =================================================
  // PART 1: BUTTON LOGIC (Change Mode Only)
  // =================================================
  int reading = digitalRead(buttonPin);

  if (reading == LOW && lastButtonState == HIGH) {
    if ((millis() - lastDebounceTime) > debounceDelay) {    
      
      mode++; 
      if (mode > 1) { mode = 0; }  
      
      // Reset counters
      currentFrame = 0;
      currentFrameS = 0;
      
      // Safety: Ensure Relay turns OFF immediately when switching modes
      digitalWrite(relayPin, HIGH); // Assuming Active LOW relay (HIGH=OFF)
      
      Serial.print("Mode changed to: "); Serial.println(mode);
      lastDebounceTime = millis(); 
    }
  }
  lastButtonState = reading; 

  // =================================================
  // PART 2: RELAY LOGIC (Inside Case 0)
  // =================================================
  if (mode == 0) {
    // Check if 1.5 seconds have passed
    if (millis() - lastRelayTime > relayInterval) {
      lastRelayTime = millis(); // Reset timer
      
      // Toggle the state (If LOW make HIGH, if HIGH make LOW)
      relayState = !relayState; 
      digitalWrite(relayPin, relayState);
    }
  } else {
    // If we are NOT in Mode 0, ensure relay stays OFF
    digitalWrite(relayPin, HIGH); // Use LOW if your relay is Active High
  }

  // =================================================
  // PART 3: ANIMATION LOGIC
  // =================================================
  if (millis() - lastFrameTime > frameDelay) {
    display.clearDisplay(); 

    // --- CASE 0: SHORT ANIMATION + RELAY ACTIVE ---
    if (mode == 0) {
       display.drawBitmap(0, 0, (const unsigned char*)pgm_read_ptr(&animationFramesS[currentFrameS]), 128, 64, SH110X_WHITE);
       currentFrameS++;
       if (currentFrameS >= frameCountS) currentFrameS = 0; 
    }

    // --- CASE 1: LONG ANIMATION ---
    else if (mode == 1) {
       display.drawBitmap(0, 0, (const unsigned char*)pgm_read_ptr(&animationFrames[currentFrame]), 128, 64, SH110X_WHITE);
       currentFrame++;
       if (currentFrame >= frameCount) currentFrame = 0; 
    }

    display.display(); 
    lastFrameTime = millis(); 
  }
}
